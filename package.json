{
  "name": "stealth-browser",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "build:renderer": "vite build && VITE_ENTRY=history vite build",
    "dev:renderer": "vite build --watch",
    "dist": "npm run build:renderer && electron-builder --mac",
    "dist:win": "npm run build:renderer && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.stealth.browser",
    "productName": "StealthBrowser",
    "mac": {
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@reduxjs/toolkit": "^2.5.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1",
    "electron-reloader": "^1.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "vite": "^6.2.3"
  },
  "dependencies": {
    "node-machine-id": "^1.1.12"
  }
}