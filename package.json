{
  "name": "invisurf",
  "version": "1.0.0",
  "description": "InviSurf browser (Electron)",
  "main": "main.js",
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "build:renderer": "node scripts/renderer-build-all.cjs",
    "dev": "node scripts/renderer-build-all.cjs && concurrently -k \"node scripts/renderer-watch.cjs\" \"electron .\"",
    "dev:renderer": "node scripts/renderer-watch.cjs",
    "dist": "npm run build:renderer && electron-builder --mac",
    "dist:win": "npm run build:renderer && electron-builder --win --x64",
    "generate-icons": "node scripts/generate-windows-icon.cjs",
    "generate-icon-win": "node scripts/generate-windows-icon.cjs"
  },
  "build": {
    "appId": "com.invisurf.browser",
    "productName": "InviSurf",
    "copyright": "Copyright © 2026 Mark Oliver",
    "asarUnpack": [
      "node_modules/@journeyapps/sqlcipher/**"
    ],
    "mac": {
      "icon": "renderer/assets/logo/icon.png",
      "target": [
        "dmg"
      ],
      "identity": null,
      "category": "public.app-category.utilities",
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.inherit.plist"
    },
    "win": {
      "icon": "renderer/assets/logo/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "renderer/assets/logo/icon.ico",
      "uninstallerIcon": "renderer/assets/logo/icon.ico",
      "installerHeaderIcon": "renderer/assets/logo/icon.ico"
    }
  },
  "keywords": [],
  "author": {
    "name": "Mark Oliver",
    "email": "dev.markoliver@gmail.com"
  },
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@reduxjs/toolkit": "^2.5.1",
    "@vitejs/plugin-react": "^4.3.4",
    "chokidar": "^3.6.0",
    "concurrently": "^9.1.2",
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1",
    "electron-reloader": "^1.2.3",
    "png-to-ico": "^2.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "sharp": "^0.34.5",
    "vite": "^6.2.3"
  },
  "dependencies": {
    "@journeyapps/sqlcipher": "^5.3.1",
    "electron-webauthn": "^1.3.1",
    "node-machine-id": "^1.1.12"
  }
}
